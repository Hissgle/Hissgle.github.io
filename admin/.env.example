# GitHub OAuth App（Settings → Developer settings → OAuth Apps）
# 回调地址：https://<你的管理端域名>/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 细粒度 PAT：只选 Hissgle/Hissgle.github.io 一个仓库
# Contents: Read and write, Actions: Read, Metadata: Read
GITHUB_CONTENT_TOKEN=

GITHUB_REPO=Hissgle/Hissgle.github.io
GITHUB_BRANCH=main

# 你的 GitHub 数字 ID（不是用户名）：https://api.github.com/users/Hissgle
ADMIN_GITHUB_ID=

# Neon Postgres 连接串（需要 sslmode=require）
DATABASE_URL=

# 32+ 字节随机串，用于 OAuth state 签名
SESSION_SECRET=

# 管理端与博客地址，结尾不要带 /
ADMIN_BASE_URL=http://localhost:3000
SITE_BASE_URL=https://hissgle.github.io
PUBLISH_TIMEZONE=Asia/Shanghai

# Vite 构建时写进前端，用于预览和「打开文章」链接；生产环境填同一个博客地址
VITE_SITE_BASE_URL=https://hissgle.github.io